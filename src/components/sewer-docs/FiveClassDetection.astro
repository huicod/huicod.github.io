  { label: "AJ 支管暗接", boxes: 100, metrics: [["80.77", "84.00", "82.35"], ["69.35", "43.00", "53.09"], ["82.98", "78.00", "80.41"]] },
  { label: "BX 变形", boxes: 16, metrics: [["38.89", "43.75", "41.18"], ["0.00", "0.00", "0.00"], ["27.27", "18.75", "22.22"]] },
