---
interface Props {
  currentPage: number;
  totalPages: number;
  total?: number;
  pageSize?: number;
  basePath?: string;
  clientPagination?: boolean;
}

const { currentPage, totalPages, basePath = "/blog/", clientPagination = false } = Astro.props;
const lastPage = Math.max(1, totalPages);
const current = Math.min(Math.max(1, currentPage), lastPage);
const base = basePath.endsWith("/") ? basePath : basePath + "/";
const pageUrl = (number: number) => number === 1 ? base : `${base}${number}/`;
---

<blog-pagination
  class="blog-pagination"
  role="navigation"
  aria-label="文章分页"
  data-pagination
  data-client-pagination={clientPagination ? "" : undefined}
  hidden={clientPagination || lastPage <= 1}
>
  <a
    class="page-step"
    data-previous
    href={current > 1 ? pageUrl(current - 1) : undefined}
    rel="prev"
    aria-disabled={current === 1 ? "true" : "false"}
    tabindex={current === 1 ? -1 : 0}
  >← 上一页</a>
  <select class="page-select" data-page-select aria-label="选择页数" hidden>
    {Array.from({ length: lastPage }, (_, index) => index + 1).map((number) => (
      <option value={clientPagination ? String(number) : pageUrl(number)} selected={number === current}>
        第 {number} / {lastPage} 页
      </option>
    ))}
  </select>
  <noscript><span>第 {current} / {lastPage} 页</span></noscript>
  <a
    class="page-step"
    data-next
    href={current < lastPage ? pageUrl(current + 1) : undefined}
    rel="next"
    aria-disabled={current === lastPage ? "true" : "false"}
    tabindex={current === lastPage ? -1 : 0}
  >下一页 →</a>
</blog-pagination>

<script>
  class BlogPagination extends HTMLElement {
    constructor() {
      super();
      this.addEventListener("change", (event) => {
        if (this.hasAttribute("data-client-pagination")) return;
        const select = event.target;
        if (select instanceof HTMLSelectElement && select.matches("[data-page-select]") && select.value) {
          window.location.assign(select.value);
        }
      });
    }

    connectedCallback() {
      this.querySelector("[data-page-select]")?.removeAttribute("hidden");
    }
  }

  if (!customElements.get("blog-pagination")) customElements.define("blog-pagination", BlogPagination);
</script>

<style>
  .blog-pagination { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: .5rem; margin-top: 2rem; padding-block: .5rem; font-size: .875rem; }
  [hidden] { display: none !important; }
  .page-step { justify-self: start; display: inline-flex; align-items: center; min-height: 2.25rem; padding: .25rem; white-space: nowrap; border-radius: .25rem; }
  .page-step:last-child { justify-self: end; }
  .page-step:hover { text-decoration: underline; text-underline-offset: .2em; }
  .page-step[aria-disabled="true"] { opacity: .35; cursor: default; pointer-events: none; }
  .page-select { width: 7.5rem; max-width: 100%; min-height: 2.25rem; padding: .25rem .5rem; background: transparent; color: inherit; border: 1px solid oklch(var(--bc) / .18); border-radius: .4rem; font: inherit; cursor: pointer; }
  .page-select option { background: oklch(var(--b1)); color: oklch(var(--bc)); }
  .page-step:focus-visible, .page-select:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  noscript { justify-self: center; white-space: nowrap; }
  @media (max-width: 360px) {
    .blog-pagination { gap: .25rem; font-size: .8125rem; }
    .page-select { width: 7rem; padding-inline: .25rem; }
  }
</style>
