---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HorizontalCard from "../../components/HorizontalCard.astro";
import BlogSearch from "../../components/BlogSearch.astro";
import BlogPagination from "../../components/BlogPagination.astro";
import { getCollection } from "astro:content";
import createSlug from "../../lib/createSlug"

export async function getStaticPaths({ paginate }) {
  const posts = (await getCollection("blog")).filter((post) => !post.data.draft);
  posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return paginate(posts, { pageSize: 10 });
}

const { page } = Astro.props;
---

<BaseLayout title="Blog" sideBarActiveItemID="blog">
  <div class="mb-5">
    <h1 class="text-3xl w-full font-bold">Blog</h1>
  </div>

  <BlogSearch total={page.total} />
  <div id="blog-listing">

  {
    page.data.length === 0 ? (
      <div class="bg-base-200 border-l-4 border-secondary w-full p-4 min-w-full">
        <p class="font-bold">Sorry!</p>
        <p>There are no blog posts to show at the moment. Check back later!</p>
      </div>
    ) : (
      <ul>
        {page.data.map((post) => (
          <>
            <HorizontalCard
              title={post.data.title}
              img={post.data.thumbnailImage ?? post.data.heroImage}
              imgClass={post.data.thumbnailImage ? "w-20 h-20 md:w-24 md:h-24 rounded-xl object-contain shrink-0" : undefined}
              imgWidth={post.data.thumbnailImage ? 96 : 750}
              imgHeight={post.data.thumbnailImage ? 96 : 422}
              desc={post.data.description}
              url={"/blog/" + createSlug(post.data.title, post.slug)}
              target="_self"
              badge={post.data.badge}
              tags={post.data.tags}
            />
            <div class="divider my-0" />
          </>
        ))}
      </ul>
    )
  }

    <BlogPagination
      currentPage={page.currentPage}
      totalPages={page.lastPage}
      total={page.total}
      pageSize={page.size}
      basePath="/blog/"
    />
  </div>
</BaseLayout>
