---
import QuickStart from "../../../components/sewer-docs/QuickStart.astro";
import Examples from "../../../components/sewer-docs/Examples.astro";
import Features from "../../../components/sewer-docs/Features.astro";
import Model from "../../../components/sewer-docs/Model.astro";
import Architecture from "../../../components/sewer-docs/Architecture.astro";
import Api from "../../../components/sewer-docs/Api.astro";
import Overview from "../../../components/sewer-docs/Overview.astro";
import Workbench from "../../../components/sewer-docs/Workbench.astro";
import Results from "../../../components/sewer-docs/Results.astro";
import Navigation from "../../../components/sewer-docs/Navigation.astro";
import "github-markdown-css/github-markdown-light.css";
import "../../../styles/sewer-docs.css";

export function getStaticPaths() {
  const pages = [
    { slug: "", label: "项目概览", group: "使用指南", title: "管网检测 Agent", lead: "Sewer Agent 帮助巡检人员从管道图片和视频中定位异常，查看模型依据，记录人工复核结果。", component: Overview },
    { slug: "quick-start", label: "快速开始", group: "使用指南", title: "运行第一次检测", lead: "在有 NVIDIA 显卡的 Linux 主机上启动工作台，上传一张图片并查看结果。", component: QuickStart },
    { slug: "workbench", label: "工作台实录", group: "使用指南", title: "工作台实录", lead: "跟着实际界面提交任务、打开检测依据，再沿视频时间线回看证据。", component: Workbench },
    { slug: "examples", label: "演示案例", group: "使用指南", title: "演示案例", lead: "下载同一模拟管道场景的图片和视频，分别体验单图检测、视频检查和对已有任务的追问。", component: Examples },
    { slug: "features", label: "功能与边界", group: "使用指南", title: "功能与边界", lead: "根据素材和要回答的问题，选择初查、复检、局部分析或报告。", component: Features },
    { slug: "model", label: "模型与数据集", group: "技术参考", title: "模型与数据集", lead: "了解线上 YOLO26s 的类别、权重来源和训练方法，以及离线 YOLO26m 的数据划分。", component: Model },
    { slug: "results", label: "实验结果", group: "技术参考", title: "实验结果", lead: "在同一批样本上比较纯 YOLO 与视觉复检，再看评分从检测框变成整张图时，数字为何不同。", component: Results },
    { slug: "architecture", label: "系统架构", group: "技术参考", title: "系统架构", lead: "从上传、工作流编排、模型执行到结果存储，跟随一次检查。", component: Architecture },
    { slug: "api", label: "开发者 API", group: "技术参考", title: "开发者 API", lead: "在服务器上配置大模型密钥。下列接口路径均相对于你部署的工作台地址。", component: Api },
  ];
  const nav = pages.map(({ component, ...meta }) => meta);
  return pages.map(({ component, ...meta }, index) => ({
    params: { section: meta.slug || undefined },
    props: { meta, nav, index, Content: component },
  }));
}
const { meta, nav, index, Content } = Astro.props;
const url = (slug: string) => "/projects/sewer-agent/" + (slug ? slug + "/" : "");
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={meta.lead} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={new URL(url(meta.slug), Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{meta.label} · Sewer Agent 文档 | huicod</title>
  </head>
  <body>
    <a class="skip" href="#article">跳到正文</a>
    <header class="mast">
      <div class="mast-inner">
        <a class="brand" href={url("")}>Sewer Agent <span>文档</span></a>
        <a class="projects-link" href="/projects/">返回 Projects</a>
      </div>
    </header>
    <div class="frame">
      <aside class="rail">
        <Navigation pages={nav} current={meta.slug} />
        <a class="model-link" href="https://huggingface.co/suwewa/sewer-agent-models">公开模型库 ↗</a>
      </aside>
      <details class="mobile-nav">
        <summary>文档目录 <span>{meta.label}</span></summary>
        <Navigation pages={nav} current={meta.slug} />
      </details>
      <main id="article">
        <h1>{meta.title}</h1>
        <p class="lead">{meta.lead}</p>
        <article class="markdown-body content"><Content /></article>
        <nav class="pager" aria-label="相邻章节">
          {index > 0 && <a href={url(nav[index - 1].slug)}>← {nav[index - 1].label}</a>}
          {index + 1 < nav.length && <a class="next" href={url(nav[index + 1].slug)}>{nav[index + 1].label} →</a>}
        </nav>
      </main>
    </div>
    <script>
      if (navigator.clipboard) {
        for (const pre of document.querySelectorAll(".content pre")) {
          const code = pre.textContent ?? "";
          const button = document.createElement("button");
          button.type = "button";
          button.className = "copy-code";
          button.textContent = "复制";
          button.setAttribute("aria-label", "复制代码");
          button.onclick = async () => {
            try { await navigator.clipboard.writeText(code); button.textContent = "已复制"; }
            catch { button.textContent = "请选中复制"; }
            setTimeout(() => { button.textContent = "复制"; }, 1600);
          };
          pre.before(button);
        }
      }
    </script>
  </body>
</html>
